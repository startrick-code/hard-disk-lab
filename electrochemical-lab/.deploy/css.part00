:root{font-family:Inter,-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Microsoft YaHei,sans-serif;color:#dce5ee;background:#0a111b;font-synthesis:none;font-size:14px;color-scheme:dark;--mint:#79d9be;--line:#24313f;--muted:#80919f;--panel:#101a26;--copper:#d8a272;--zinc:#a4bdce}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}button,a,input,select{outline-offset:4px}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--mint)}button{border:1px solid var(--line);color:#bdcbd5;background:#14202c;border-radius:7px;min-height:44px;transition:background .18s,border-color .18s}button:hover{background:#1c2e3a;border-color:#486457}button:disabled{cursor:default;opacity:.6}butto