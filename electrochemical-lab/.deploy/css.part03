up{padding:17px 21px;border-bottom:1px solid #23313d}.control-group:last-child{border:0}.switch-row{display:flex;align-items:center;justify-content:space-between;font-size:12px;margin-bottom:17px}.toggle{display:flex;align-items:center;gap:8px;padding:0;border:none;min-height:30px;background:transparent}.toggle:hover{background:transparent}.toggle span{width:29px;height:16px;border-radius:10px;background:#344451;position:relative}.toggle span:after{content:"";position:absolute;width:10px;height:10px;left:3px;top:3px;background:#8d9ca7;border-radius:50%}.toggle.on span{background:#417e6c}.toggle.on span:after{left:16px;background:#a7eed4}.toggle b{font-size:10px;font-weight:400;color:#7ea795}.label{display:block;color:#93a7b6;font-size:11px;margin:13px 0 10px}.label span{font-size:9px;float:right;color:#657c8a}.topology-options{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-bottom:17px}.topology-options button{font-size:10px;min-height:33px;padding:4px}.range-label{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#8ea5b4;margin-top:11px}.range-label>span:last-child{font:11px ui-monospace,monospace;color:#c7d5df}.range-label i{color:#718996;font:10px sans-serif}.range-label output{font-variant-numeric:tabular-nums}input[type=range]{display:block;width:100%;height:23px;margin:2px 0;accent-color:#8ad6bb;cursor:pointer;background:transparent}input[type=range]::-webkit-slider-runnable-track{height:3px;background:#334b4e;border-radius:3px}input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;height:12px;width:12px;margin-top:-4.5px;border:2px solid #a2d9c7;border-radius:50%;background:#153d35}input[type=range]{-webkit-appearance:none;appearance:none}input[type=range]::-moz-range-track{height:3px;background:#334b4e}input[type=range]::-moz-range-thumb{height:10px;width:10px;border:2px solid #a2d9c7;border-radius:50%;background:#153d35}.subtle-row{display:flex;justify-content:space-between;font-size:10px;color:#6d89