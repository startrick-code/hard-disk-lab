px solid #293641}.metrics>div:first-child{padding-left:9px}.metrics>div:last-child{border:none}.metrics span{display:block;font-size:10px;color:#8fa2ae;margin-bottom:8px}.metrics i{font-family:Georgia,serif;color:#b3c6d1;margin-left:4px;font-size:13px}.metrics strong{font:500 clamp(21px,2.25vw,32px) ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:-1px}.metrics small{font:11px sans-serif;letter-spacing:0;color:#7a92a3}.scene-wrap{position:relative;background:radial-gradient(ellipse at 52% 62%,#152b33aa,transparent 64%)}.scene-caption{height:41px;display:flex;justify-content:space-between;align-items:center;padding:0 24px;color:#607e8b;font:9px ui-monospace,monospace;letter-spacing:1px}.scene-caption .chip{min-height:28px;padding:3px 10px;font-size:10px;margin-left:4px}#scene{display:block;width:100%;height:auto;touch-action:none;user-select:none;-webkit-user-select:none;overflow:hidden}#scene .wire{fill:none;stroke:#76b8a9;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 3px #6ad8bb30)}#scene text{pointer-events:none}#scene .label{fill:#b4c6d0;font-size:13px}#scene .muted{fill:#7e9aaa;font-size:12px}#scene .tiny{fill:#89a5b0;font-size:11px}#scene .glass{fill:none;stroke:#6c8999;stroke-width:2;stroke-opacity:.65}#scene .resistor{fill:#24312f;stroke:#c1ba86;stroke-width:2}#scene .meter{fill:#11222a;stroke:#4c8c83;stroke-width:1.5}#scene .meter-symbol{fill:#9bd7c4;font-family:Georgia,serif;font-size:20px}#scene .switch-line{stroke:#8ad4bc;stroke-width:3}#scene .measure-line{stroke:#4b6571;stroke-width:1;stroke-dasharray:4 5;fill:none}#scene .metal-symbol{font:700 24px Georgia,serif;fill:#182730}#scene .focus-ring{fill:#0c2029;stroke:#598779;stroke-width:1}#scene .focus-text{fill:#7fbea9;font-size:18px}#scene .reaction{fill:#c2d4dc;font:15px Georgia,serif}#scene .scene-heading{fill:#b1c9d3;font-size:16px}#scene .ion-text{fill:#c3d5df;font:8px sans-serif}#scene .clickable{cursor:pointer}.mint,#scene .mint{color:#82d9bd;fill:#82d9bd}.gold,#scene .gold{color:#dfb57d;fill:#dfb57d}.purple,#scene .purple{color:#b79cdd;fill:#b79cdd}.zinc-text,#scene .zinc-text{color:#a4bdce;fill:#a4bdce}.copper-text,#scene .copper-text{color:#dca577;fill:#dca577}.blue{color:#6bace0}.red{color:#dca39c}.lavender{color:#9badd5}#scene .mint,#scene .gold,#scene .purple,#scene .zinc-text,#scene .copper-text{font-size:12px}.zoom-controls{position:absolute;right:18px;bottom:13px;display:flex;align-items:center;border:1px solid #2c424b;border-radius:7px;background:#10202ae8;overflow:hidden}.zoom-controls button{border:none;border-radius:0;background:transparent;min-height:35px;min-width:35px;font-size:16px;padding:3px 8px}.zoom-controls button:hover{background:#213d40}.zoom-controls output{color:#849da9;font:10px ui-monospace,monospace;width:38px;text-align:center}.zoom-controls #deeper{font-size:11px;border-left:1px solid #2c424b;color:#8ecdbb}.scene-legend{display:flex;gap:19px;align-items:center;padding:13px 24px 17px;font-size:10px;color:#8ba0ae}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:5px}.zinc{background:#a4bdce}.copper{background:#dca577}.electron{background:#79d9be}.purple-bg{background:#b79cdd}.gold-bg{background:#dfb57d}.legend-hint{margin-left:auto;color:#617c8a;font-size:9px}.reaction-strip{display:flex;align-items:center;gap:18px;padding:15px 25px;border-top:1px solid #253840;background:#15272e;font-size:11px}.reaction-strip>span:first-child{color:#79a298;font-size:10px}.reaction-strip b{font:14px Georgia,serif;color:#bdd8cf}.reaction-strip>span:last-child{color:#90b4ab;font:10px ui-monospace,monospace;margin-left:auto}.scene-footnote{color:#6f8b98;font-size:10px;padding:12px 24px;line-height:1.7}.panel-heading{padding:19px 21px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}h3,h4{font-weight:550;margin:0}.panel-heading h3{font-size:14px}.panel-heading>span{font-size:8px;letter-spacing:1.3px;color:#667c8b}.control-gro