n.active{color:var(--mint);background:#1b3535;border-color:#3e7165}button.primary{background:#83dec3;color:#102d2a;font-weight:650;border-color:#83dec3;padding:0 20px}button.primary:hover{background:#a1ecd5}button.secondary{background:#1b2c37;padding:8px 12px}.full{width:100%}.icon-button{background:transparent;padding:0 12px}.text-button{background:transparent;border:none;color:#9aafbd;min-height:44px}.topbar{height:90px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 32px;background:#0d1621}.brand{display:flex;align-items:center;gap:14px}.brand-icon{color:#7ae0c1;width:43px;height:43px;border:1px solid #42695e;border-radius:11px;display:grid;place-items:center;background:linear-gradient(135deg,#203e3a,#10232b)}h1{font-size:19px;font-weight:650;letter-spacing:.6px;margin:0 0 6px}.brand p{font-size:10px;letter-spacing:.45px;color:#8096a5;margin:0}.version{font-size:9px;letter-spacing:1.3px;color:#a4b4c2;border:1px solid #31404e;border-radius:4px;padding:5px 7px;margin-left:6px}.run-controls{display:flex;align-items:center;gap:12px}.clock{display:grid;grid-template-columns:9px auto;align-items:center;column-gap:8px;margin-right:12px}.clock b{font:14px ui-monospace,SFMono-Regular,Consolas,monospace;font-variant-numeric:tabular-nums}.clock small{grid-column:2;font-size:9px;color:#768d9a;margin-top:5px}.live-dot{display:inline-block;background:var(--mint);width:6px;height:6px;border-radius:50%;box-shadow:0 0 9px #79d9be33}main{max-width:1600px;margin:auto;padding:30px 32px 0}.intro{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}.eyebrow{font-size:9px;letter-spacing:1.7px;color:#7db6a9;font-weight:600}.intro h2{font-size:27px;letter-spacing:1px;font-weight:550;margin:12px 0 8px}.intro p{font-size:12px;color:#8298a7;margin:0}.model-badge{display:flex;align-items:center;gap:10px;color:#c0cbd6;font-size:12px}.model-badge>span:nth-of-type(2){border-left:1px solid #36434e;padding-left:12px;color:#91a4b5;font-family:monospace}.model-badge i{color:#8195a5;font-style:normal;font-size:11px}.presets{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.presets button{display:flex;align-items:center;gap:12px;padding:14px 15px;background:#111d29;text-align:left;border-color:#273541}.presets button:hover,.presets button.active{background:#172d31;border-color:#4b776c}.presets button>b{height:32px;width:32px;display:grid;place-items:center;color:#90b7ae;font:15px ui-monospace,monospace;border:1px solid #354b4d;border-radius:7px;background:#1a2a31}.presets button>span{font-size:13px;font-weight:550}.presets small{display:block;color:#7a919f;font-size:10px;font-weight:400;margin-top:5px}.presets .chevron{margin-left:auto;color:#6c8c92}.experiment-note{min-height:52px;display:flex;gap:15px;align-items:center;font-size:11px;margin:7px 0;color:#849aaa}.experiment-note b{color:#a9c6ba;white-space:nowrap}.experiment-note code{margin-left:auto;color:#8ba9a4;font-size:10px;text-align:right;white-space:nowrap}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px;align-items:start}.panel{border:1px solid var(--line);background:#101a25;border-radius:11px;overflow:hidden}.scene-toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:13px 18px;border-bottom:1px solid var(--line);background:#111d28}.segmented{display:flex;gap:4px;background:#0b1520;padding:4px;border:1px solid #24323e;border-radius:7px}.segmented button{border:1px solid transparent;min-height:35px;padding:7px 12px;background:transparent;font-size:11px;color:#7b8f9e}.segmented button span{margin-left:4px}.segmented button.active{background:#203b3c;border-color:#3b5e59;color:#9de3cd}.status{font-size:10px;white-space:nowrap;color:#91dbbe}.status.inactive{color:#adad9c}.metrics{display:grid;grid-template-columns:repeat(4,1fr);padding:24px 20px 18px;background:linear-gradient(180deg,#13212c,#101a25)}.metrics>div{padding:0 22px;border-right:1